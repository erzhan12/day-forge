# syntax=docker/dockerfile:1
# Thin MCP proxy image — only the `mcp` dependency group (SDK + httpx), not Django.

FROM python:3.14-slim AS deps
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
# Install only the mcp group into a project-local .venv (no Django / no project package).
RUN uv sync --frozen --only-group mcp --no-install-project

FROM python:3.14-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    DAYFORGE_API_BASE=http://web:8006 \
    DAYFORGE_API_HOST=dayforge.habitreward.org \
    MCP_ALLOWED_HOSTS=dayforge.habitreward.org \
    MCP_PORT=8007
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home app

WORKDIR /app
COPY --from=deps /app/.venv /app/.venv
COPY mcp_server/ /app/mcp_server/
RUN chown -R app:app /app

USER app
EXPOSE 8007

# Slim image has no curl; probe with stdlib urllib.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8007/mcp/health', timeout=4)"]

CMD ["python", "-m", "mcp_server"]
